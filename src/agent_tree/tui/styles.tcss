/* Agent Tree TUI */

Screen {
    layout: vertical;
    background: $background;
}

#body {
    height: 1fr;
    layout: vertical;
}

/* ── Main area: tree (left) + output (right) ── */
#main-panels {
    height: 1fr;
    layout: horizontal;
}

#tree-panel {
    width: 40%;
    min-width: 30;
    layout: vertical;
    border-right: solid $primary-darken-2;
}

#tree-label {
    height: 1;
    background: $primary-darken-3;
    color: $text;
    text-style: bold;
    padding: 0 1;
}

TreeView {
    height: 1fr;
    padding: 0 1;
    overflow-y: auto;
    scrollbar-gutter: stable;
}

#output-panel {
    width: 1fr;
    layout: vertical;
}

#output-label {
    height: 1;
    background: $success-darken-3;
    color: $text;
    text-style: bold;
    padding: 0 1;
}

#output-scroll {
    height: 1fr;
    padding: 0 1;
    overflow-y: auto;
    scrollbar-gutter: stable;
}

#output-content {
    height: auto;
    padding: 1 0;
}

/* ── Input panel ── */
#input-panel {
    height: auto;
    max-height: 18;
    border-top: solid $accent-darken-2;
}

#input-label {
    height: 1;
    background: $accent-darken-3;
    color: $text;
    text-style: bold;
    padding: 0 1;
}

TaskInput {
    height: auto;
    min-height: 6;
    max-height: 15;
}

TaskInput TextArea {
    height: auto;
    min-height: 5;
    max-height: 13;
    border: none;
    background: $surface;
}

TaskInput TextArea:focus {
    border: none;
}
