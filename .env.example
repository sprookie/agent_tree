# Agent Tree environment variables
# Copy this file to .env and fill in your values

# DeepSeek API key — get it from https://platform.deepseek.com/api_keys
# Set as OPENAI_API_KEY because LangChain uses the openai provider for custom endpoints
OPENAI_API_KEY=your_deepseek_api_key_here
OPENAI_API_BASE=https://api.deepseek.com/v1

# Model to use:
#   deepseek-v4-pro   — flagship (1.6T params, 1M context, recommended)
#   deepseek-v4-flash — lightweight, faster and cheaper
#   Note: deepseek-chat is deprecated as of 2026/07/24 (= deepseek-v4-flash non-thinking)
AGENT_TREE_MODEL=openai:deepseek-v4-pro
AGENT_TREE_MAX_DEPTH=3

# Anthropic API key (only needed if you switch to anthropic:* model strings)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
