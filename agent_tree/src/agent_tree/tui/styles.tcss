#top-section {
    padding: 1 2;
    height: 1fr;
}
#title {
    text-style: bold;
    color: $accent;
    padding: 1 0;
}
#subtitle {
    color: $text-muted;
    padding: 0 0 1 0;
}
TreeView {
    border: solid $accent;
    margin: 1 0;
    padding: 1 2;
}
TaskInput TextArea {
    border: solid $primary;
    min-height: 8;
}
